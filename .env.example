# Os exemplos carregam .env sem sobrescrever valores do processo, Docker ou CI.
CONTEXT_ENGINE_PGVECTOR_HOST=127.0.0.1
CONTEXT_ENGINE_PGVECTOR_DATABASE=context_engine
CONTEXT_ENGINE_PGVECTOR_USERNAME=context_engine
CONTEXT_ENGINE_PGVECTOR_PASSWORD=context_engine
CONTEXT_ENGINE_PGVECTOR_PORT=54339

CONTEXT_ENGINE_OLLAMA_URL=http://127.0.0.1:11434
CONTEXT_ENGINE_OLLAMA_EMBEDDING_MODEL=bge-m3
CONTEXT_ENGINE_OLLAMA_EMBEDDING_DIMENSIONS=1024
CONTEXT_ENGINE_OLLAMA_LANGUAGE_MODEL=qwen3:8b
CONTEXT_ENGINE_OLLAMA_LLM_TIMEOUT=300

CONTEXT_ENGINE_OPENAI_API_KEY=
CONTEXT_ENGINE_OPENAI_MODEL=gpt-4.1-mini
CONTEXT_ENGINE_OPENAI_URL=https://api.openai.com/v1

CONTEXT_ENGINE_GEMINI_API_KEY=
CONTEXT_ENGINE_GEMINI_MODEL=gemini-3.6-flash
CONTEXT_ENGINE_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta

CONTEXT_ENGINE_TENANT_ID=empresa-exemplo
CONTEXT_ENGINE_COLLECTION=default
CONTEXT_ENGINE_STATUS=active
CONTEXT_ENGINE_BATCH_SIZE=32
CONTEXT_ENGINE_CONCURRENCY=4
CONTEXT_ENGINE_CHUNK_SIZE=1000
CONTEXT_ENGINE_CHUNK_OVERLAP=150
CONTEXT_ENGINE_RETRIEVAL_LIMIT=5
CONTEXT_ENGINE_RETRIEVAL_METRIC=cosine
CONTEXT_ENGINE_MAXIMUM_DISTANCE=0.45

CONTEXT_ENGINE_REDIS_PASSWORD=context_engine
CONTEXT_ENGINE_REDIS_PORT=63809

CONTEXT_ENGINE_RUN_PGVECTOR_TESTS=0
CONTEXT_ENGINE_RUN_REDIS_TESTS=0
